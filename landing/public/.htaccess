Options -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Força HTTPS e domínio sem www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://clinica-aurea.com%{REQUEST_URI} [L,R=301]

# Remove .html e barra final da URL (URLs limpas: /sobre, /servicos/...)
RewriteCond %{REQUEST_URI} !^/google[a-z0-9]+\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# Serve /sobre a partir de sobre.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]

# Links antigos do sistema (quando ele ficava na raiz) -> subdomínio do app
RewriteRule ^(login|dashboard|patients|appointments|financial)(/.*)?$ https://app.clinica-aurea.com/$1$2 [R=302,L]
RewriteRule ^(patient-form|cadastro|staff-signup|patient-signup|t|access-pending)(/.*)?$ https://app.clinica-aurea.com/$1$2 [R=302,L]

# Cache de assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

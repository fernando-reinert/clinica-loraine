---
import Base from "../layouts/Base.astro";
---
<Base title="Página não encontrada | Clínica Áurea" description="A página que você procura não existe." path="/404">
  <section class="site-section" style="text-align:center;min-height:50vh;display:flex;flex-direction:column;align-items:center;justify-content:center">
    <h1>Página não encontrada</h1>
    <p style="color:var(--site-fg-muted)">O endereço que você acessou não existe ou foi movido.</p>
    <a href="/" class="site-btn-gold" style="margin-top:1.5rem">Voltar ao início</a>
  </section>
</Base>
